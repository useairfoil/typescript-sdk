ype\":\"date\",\"formField\":false,\"groupName\":\"lead_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"First Outreach Date\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_lead_first_outreach_date\",\"options\":[],\"type\":\"datetime\",\"updatedAt\":\"2026-09-17T14:26:19.581Z\"},{\"calculated\":false,\"createdAt\":\"2024-07-22T21:48:49.352Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Flow id of the workflow that created this lead\",\"displayOrder\":-1,\"externalOptions\":true,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"lead_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Lead flow id\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_lead_flow_id\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2026-07-22T17:21:15.328Z\"},{\"calculated\":false,\"createdAt\":\"2024-07-26T16:10:52.574Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"A key with format {importUUID}-{primaryAssociationObjectTypeId}-{primaryAssociationObjectId} that enforces idempotency on lead imports\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"text\",\"formField\":false,\"groupName\":\"lead_information\",\"hasUniqueValue\":true,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Import Unique Key\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":false,\"readOnlyValue\":true},\"name\":\"hs_lead_import_unique_key\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2026-07-22T17:21:15.328Z\"},{\"calculated\":false,\"calculationFormula\":\"(if max(hs_calls_connected_count, hs_emails_connected_count, hs_meetings_connected_count, 0) > 0 then 'CONNECTED_STAGE'\\nelse(if hs_lead_outreach_activity_count > 0 then 'FIRST_IN_PROGRESS_STAGE' else 'NEW_STAGE'))\",\"createdAt\":\"2023-06-30T20:26:03.327Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"This indicates the inferred lead pipeline pseudostage based on underlying activities taken by the user or lead.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"lead_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Lead Inferred Pseudostage\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_lead_inferred_pseudostage\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2026-08-06T17:43:40.950Z\"},{\"calculated\":true,\"calculationFormula\":\"(if string(hs_pipeline_stage_category) equals 'UNQUALIFIED' then 1 else 0)\",\"createdAt\":\"2023-07-10T19:21:20.316Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Indicates whether the lead is disqualified (with a value of 1) or not (with a value of 0). Hidden property that exists for the purpose of reporting.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"lead_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Is Disqualified\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_lead_is_disqualified\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2026-07-22T17:21:15.328Z\"},{\"calculated\":false,\"calculationFormula\":\"(if string(hs_pipeline_stage_category) equals 'IN_PROGRESS' then 1 else 0)\",\"createdAt\":\"2023-04-07T15:01:15.573Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Indicates whether the lead is in progress (with a value of 1) or not (with a value of 0). Hidden property that exists for the purpose of reporting.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"lead_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"In progress leads\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_lead_is_in_progress\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2026-07-22T17:21:15.328Z\"},{\"calculated\":true,\"calculationFormula\":\"(if string(hs_pipeline_stage_category) equals 'NEW' then 1 else 0)\",\"createdAt\":\"2023-07-10T18:52:39.715Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Indicates whether the lead is new (with a value of 1) or not (with a value of 0). Hidden property that exists for the purpose of reporting.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"lead_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Is New\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_lead_is_new\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2026-07-22T17:21:15.328Z\"},{\"calculated\":false,\"calculationFormula\":\"(if set_contains_string(['NEW', 'IN_PROGRESS'], string(hs_pipeline_stage_category)) then 1 else 0)\",\"createdAt\":\"2023-04-04T18:17:40.041Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Whether the lead's pipeline stage has any category other than `QUALIFIED` or `UNQUALIFIED`\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"lead_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Open leads\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_lead_is_open\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2026-07-22T17:21:15.328Z\"},{\"calculated\":true,\"calculationFormula\":\"(if is_present(string(hs_pipeline_stage_category_v2)) then (if (string(hs_pipeline_stage_category_v2) equals 'NEW' or string(hs_pipeline_stage_category_v2) equals 'IN_PROGRESS') then true else false) else false)\",\"createdAt\":\"2025-02-14T16:20:24.045Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Whether the lead's pipeline stage has category \\\"Not started\\\" or \\\"In progress\\\"\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"lead_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Is Open\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_lead_is_open_v2\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"Yes\",\"value\":\"true\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"No\",\"value\":\"false\"}],\"type\":\"bool\",\"updatedAt\":\"2026-07-22T17:21:15.328Z\"},{\"calculated\":true,\"calculationFormula\":\"(if string(hs_pipeline_stage_category) equals 'QUALIFIED' then 1 else 0)\",\"createdAt\":\"2023-07-10T19:03:23.748Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Indicates whether the lead is qualified (with a value of 1) or not (with a value of 0). Hidden property that exists for the purpose of reporting.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"lead_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Is Qualified\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_lead_is_qualified\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2026-07-22T17:21:15.328Z\"},{\"calculated\":false,\"createdAt\":\"2023-04-26T19:30:52.847Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Current status of a given lead\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"select\",\"formField\":false,\"groupName\":\"lead_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Lead Label\",\"modificationMetadata\