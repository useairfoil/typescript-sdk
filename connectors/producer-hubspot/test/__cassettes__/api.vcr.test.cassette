 user who created this record. This value is set automatically by HubSpot.\",\"displayOrder\":-1,\"externalOptions\":true,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"invoiceinformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Created by user ID\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_created_by_user_id\",\"numberDisplayHint\":\"unformatted\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2024-11-04T20:30:19.881Z\"},{\"calculated\":false,\"createdAt\":\"2021-03-16T18:01:53.196Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The date and time at which this object was created. This value is automatically set by HubSpot and may not be modified.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"date\",\"formField\":false,\"groupName\":\"invoiceinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Create Date\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_createdate\",\"options\":[],\"type\":\"datetime\",\"updatedAt\":\"2024-09-05T17:14:04.747Z\"},{\"calculated\":false,\"createdAt\":\"2025-11-20T20:05:18.190Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Serialized JSON that captures the Credit Memos applied to an Invoice. Used exclusively for Data Sync integration.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"textarea\",\"formField\":false,\"groupName\":\"invoiceinformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Credit Memo Applications\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_credit_memo_applications\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2025-11-20T20:05:18.190Z\"},{\"calculated\":false,\"createdAt\":\"2020-03-10T12:40:18.084Z\",\"dataSensitivity\":\"non_s