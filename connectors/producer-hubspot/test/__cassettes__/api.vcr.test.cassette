            "body": "{\"completedAt\":\"2026-10-14T11:35:50.977Z\",\"results\":[{\"archived\":false,\"createdAt\":\"2026-10-11T17:51:56.629Z\",\"id\":\"406251820782\",\"properties\":{\"hs_ai_detected_language\":null,\"hs_ai_detected_language_confidence\":null,\"hs_ai_is_noise\":null,\"hs_ai_thread_detected_language\":null,\"hs_ai_thread_detected_language_confidence\":null,\"hs_ai_thread_is_noise\":null,\"hs_ai_thread_summary\":null,\"hs_ai_thread_summary_short\":null,\"hs_all_accessible_team_ids\":null,\"hs_all_assigned_business_unit_ids\":null,\"hs_all_owner_ids\":null,\"hs_all_team_ids\":null,\"hs_app_id\":null,\"hs_at_mentioned_owner_ids\":null,\"hs_at_mentioned_team_ids\":null,\"hs_attachment_ids\":null,\"hs_body_preview\":\"Hey Maria, I heard your company is in the market for new swimwear lines. We're the fastest-growing luxury swimwear manufacturer in the world. I'd love to show you what we have. Yours, Brian Want more than just swimwear? We also make the best beach accessories too.\",\"hs_body_preview_html\":\"<html>\\n<head></head>\\n<body>\\n<span>Hey Maria,</span> \\n<br> \\n<br> \\n<span>I heard your company is in the market for new swimwear lines. We're the fastest-growing luxury swimwear manufacturer in the world.</span> \\n<br> \\n<br> \\n<span>I'd love to show you what we have.</span> \\n<br> \\n<br> \\n<span>Yours,</span> \\n<br> \\n<span>Brian</span> \\n<br> \\n<br> \\n<em>Want more than just swimwear? We also make the best beach accessories too.</em> \\n<p></p>\\n</body>\\n</html>\",\"hs_body_preview_is_truncated\":\"false\",\"hs_campaign_guid\":null,\"hs_campaign_guids\":null,\"hs_created_by\":null,\"hs_created_by_user_id\":null,\"hs_createdate\":\"2026-10-11T17:51:56.629Z\",\"hs_direction_and_unique_id\":null,\"hs_email_associated_contact_id\":\"567789759188\",\"hs_email_attached_video_id\":null,\"hs_email_attached_video_name\":null,\"hs_email_attached_video_opened\":\"false\",\"hs_email_attached_video_watched\":\"false\",\"hs_email_bcc_email\":n