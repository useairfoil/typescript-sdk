llingfrequency) equals 'per_two_years' then 24\\nelseif string(recurringbillingfrequency) equals 'per_six_months' then 6\\nelseif string(recurringbillingfrequency) equals 'quarterly' then 3 endif), 0)\\nelseif not (is_present(string(recurringbillingfrequency))) then 1 endif\",\"createdAt\":\"2022-04-13T21:17:22.947Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Number of payments for the given period on a Line Item\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"price\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Number of payments\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_recurring_billing_number_of_payments\",\"options\":[],\"showCurrencySymbol\":false,\"type\":\"number\",\"updatedAt\":\"2026-05-19T19:19:11.144Z\"},{\"calculated\":false,\"createdAt\":\"2019-08-06T02:42:39.786Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Product recurring billing duration\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"text\",\"formField\":false,\"groupName\":\"term\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Term\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_recurring_billing_period\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2022-05-28T01:37:44.422Z\"},{\"calculated\":false,\"createdAt\":\"2019-08-06T02:42:39.820Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Recurring billing start date for a line item\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"date\",\"formField\":false,\"groupName\":\"term\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Billing start date\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_recurring_bill