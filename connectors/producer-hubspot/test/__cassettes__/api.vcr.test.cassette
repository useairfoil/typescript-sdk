all quote\",\"value\":\"PDF_GENERATION_FAILED_RECALL\"},{\"displayOrder\":5,\"hidden\":false,\"label\":\"Pdf for quote has regenerated\",\"value\":\"PDF_REGENERATED\"}],\"type\":\"enumeration\",\"updatedAt\":\"2026-09-22T20:14:18.650Z\"},{\"calculated\":false,\"createdAt\":\"2026-09-09T22:47:49.460Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The Quote's PDF size in Bytes. This is only filled after a pdf is created.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"quoteinformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"PDF Size\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_pdf_size\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2026-09-09T22:47:49.460Z\"},{\"calculated\":false,\"dataSensitivity\":\"non_sensitive\",\"description\":\"The object ID of the current pinned engagement. This will only be shown in the app if there is already an association to the engagement.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"quoteinformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Pinned engagement ID\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_pinned_engagement_id\",\"options\":[],\"type\":\"number\"},{\"calculated\":false,\"createdAt\":\"2019-08-06T02:43:13.820Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Color value used on the quote document\",\"displayOrder\":6,\"externalOptions\":false,\"fieldType\":\"text\",\"formField\":false,\"groupName\":\"quoteinformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Branding color\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_primary_color\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2025-01-14T22:12:48.870Z\"},{\"calculated\":true,\"calculationFormula\":\"if is_present(string(hs_domain)) then string(hs_domain) endif\",\"createdAt\":\"2020-05-21T17:53:46.376Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Domain this proposal should be served from\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"quoteinformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Proposal Domain\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_proposal_domain\",\"options\":[],\"showCurrencySymbol\":false,\"type\":\"string\",\"updatedAt\":\"2026-02-19T16:48:48.705Z\"},{\"calculated\":true,\"calculationFormula\":\"if is_present(string(hs_slug)) then string(hs_slug) endif\",\"createdAt\":\"2020-06-03T17:29:46.122Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Path to serve this proposal from\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"quoteinformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Proposal Slug\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_proposal_slug\",\"options\":[],\"showCurrencySymbol\":false,\"type\":\"string\",\"updatedAt\":\"2026-02-19T17:03:05.726Z\"},{\"calculated\":false,\"createdAt\":\"2020-06-03T17:29:55.631Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Template Path this proposal is rendered with\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"text\",\"formField\":false,\"groupName\":\"quoteinformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Proposal Template\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_proposal_template_path\",\"options\":[],\"showCurrencySymbol\":false,\"type\":\"string\",\"updatedAt\":\"2026-02-19T17:03:58.962Z\"},{\"calculated\":false,\"createdAt\":\"2019-08-06T02:43:14.286Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Key for accessing quote document URL\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"text\",\"formField\":false,\"groupName\":\"quoteinformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Public URL key\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_public_url_key\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2025-01-14T22:12:48.870Z\"},{\"calculated\":false,\"createdAt\":\"2025-10-17T15:02:33.281Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Purchase Order editability\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"select\",\"formField\":false,\"groupName\":\"quoteinformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Purchase Order editability\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_purchase_order_editability\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"READONLY\",\"value\":\"readonly\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"EDITABLE\",\"value\":\"editable\"}],\"type\":\"enumeration\",\"updatedAt\":\"2025-10-17T15:02:33.281Z\"},{\"calculated\":false,\"createdAt\":\"2025-10-07T19:44:06.719Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Purchase order number\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"text\",\"formField\":false,\"groupName\":\"quoteinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"PO number\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_purchase_order_number\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2025-10-10T14:37:53.592Z\"},{\"calculated\":true,\"calculationFormula\":\"if is_present(hs_quote_print_count) then hs_quote_print_count else 0 + if is_present(hs_quote_view_count) then hs_quote_view_count else 0 + if is_present(hs_quote_download_count) then hs_quote_download_count else 0\",\"createdAt\":\"2025-05-14T15:11:35.027Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"A measurement of the activity on a quote. By default this is the sum of all print, download, and view events\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"quotetrackinginformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Activity Count\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_quote_activity_count\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2026-04-13T22:52:31.395Z\"},{\"calculated\":true,\"calculationFormula\":\"if is_present(hs_quote_print_count_since_last_communication) then hs_quote_print_count_since_last_communication else 0 + if is_present(hs_quote_view_count_since_last_communication) then hs_quote_view_count_since_last_communication else 0 + if is_present(hs_quote_download_count_since_last_communication) then hs_quote_download_count_since_last_communication else 0\",\"createdAt\":\"2025-05-14T15:12:49.082Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"A measurement of the activity on a quote since the last communication. By default this is the sum of all print, download, and view events\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"quotetrackinginformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Activity Count Since Last Communication\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_quote_activity_count_since_last_communication\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2026-04-13T22:52:31.395Z\"},{\"calculated\":false,\"createdAt\":\"2019-12-17T19:35:26.599Z\",\"currencyPropertyName\":\"hs_currency\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The total amount due for the quote. This can be either total contract value or the amount due at checkout depending on portal settings\",\"displayOrder\":12,\"externalOptions\":false,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"quoteinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Amount\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_quote_amount\",\"options\":[],\"showCurrencySymbol\":true,\"type\":\"number\",\"updatedAt\":\"2026-04-13T22:52:31.395Z\"},{\"calculated\":true,\"calculationFormula\":\"exchange_rate(string(hs_currency)) * hs_quote_amount\",\"createdAt\":\"2025-05-15T18:03:26.164Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The quote amount in the portal's home currency. This will not be updated if the home currency is changed\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"quoteinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Amount in Home Currency\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_quote_amount_in_home_currency\",\"options\":[],\"showCurrencySymbol\":true,\"type\":\"number\",\"updatedAt\":\"2026-04-13T22:52:31.395Z\"},{\"calculated\":false,\"createdAt\":\"2026-03-03T18:45:26.597Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Buyer authentication setting for shared quote links\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"select\",\"formField\":false,\"groupName\":\"quoteinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Authentication method\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_quote_auth_method\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"Public access\",\"value\":\"public_access\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"Password\",\"value\":\"password\"}],\"type\":\"enumeration\",\"updatedAt\":\"2026-04-13T22:52:31.395Z\"},{\"calculated\":false,\"createdAt\":\"2026-03-06T02:54:19.902Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The password to access the quote for a password authentication method.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"text\",\"formField\":false,\"groupName\":\"quoteinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Authentication password\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_quote_auth_password\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2026-04-13T22:52:31.395Z\"},{\"calculated\":false,\"createdAt\":\"2025-05-12T18:59:08.070Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The count of all download activity on a quote\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"quotetrackinginformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Download Count\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_quote_download_count\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2026-04-13T22:52:31.395Z\"},{\"calculated\":false,\"createdAt\":\"2025-05-12T19:03:03.372Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The number of downloads a quote has received since the last communication with a customer\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"quotetrackinginformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Download Count Since Last Communication\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_quote_download_count_since_last_communication\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2026-04-13T22:52:31.395Z\"},{\"calculated\":true,\"calculationFormula\":\"if not (is_present(bool(hs_locked))) or not (bool(hs_locked)) then 'NO_ESIGN_STATUS'\\nelseif (not (is_present(bool(hs_show_signature_box))) or not (bool(hs_show_signature_box))) and (not (is_present(bool(hs_esign_enabled))) or not (bool(hs_esign_enabled))) then 'NO_ESIGN_STATUS'\\nelseif (is_present(hs_esign_date) and not (hs_esign_date equals 0)) or (is_present(bool(hs_manually_signed)) and bool(hs_manually_signed)) then 'SIGNED' else 'PENDING_SIGNATURE'\",\"createdAt\":\"2025-10-09T16:43:38.160Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Calculated status for quote e-signature progress based on esign enablement and signature completion\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"quoteinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Signing Status\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_quote_esign_status\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"Not Applicable\",\"value\":\"NO_ESIGN_STATUS\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"Pending Signature\",\"value\":\"PENDING_SIGNATURE\"},{\"displayOrder\":2,\"hidden\":false,\"label\":\"Signed\",\"value\":\"SIGNED\"}],\"type\":\"enumeration\",\"updatedAt\":\"2025-10-24T18:06:47.942Z\"},{\"calculated\":false,\"createdAt\":\"2023-06-13T19:22:17.920Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The url hosting the public quote. This will be empty if the quote is not publicly available.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"text\",\"formField\":false,\"groupName\":\"quoteinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Link to hosted Quote\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_quote_link\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2025-08-09T00:03:03.808Z\"},{\"calculated\":false,\"createdAt\":\"2019-08-06T02:43:14.200Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Reference number shown on quote document\",\"displayOrder\":14,\"externalOptions\":false,\"fieldType\":\"text\",\"formField\":false,\"groupName\":\"quoteinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Quote number\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_quote_number\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2026-04-13T23:07:39.441Z\"},{\"calculated\":false,\"createdAt\":\"2024-09-11T16:00:49.389Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The owner of this quote. This will be the associated deal's owner or the quote's creator if there is no associated deal.\",\"displayOrder\":-1,\"externalOptions\":true,\"fieldType\":\"select\",\"formField\":false,\"groupName\":\"quoteinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Owner ID\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_quote_owner_id\",\"options\":[],\"referencedObjectType\":\"OWNER\",\"type\":\"enumeration\",\"updatedAt\":\"2026-04-13T22:52:31.395Z\"},{\"calculated\":false,\"createdAt\":\"2025-05-12T18:59:37.459Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The count of all print activity on a quote\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"quotetrackinginformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Print Count\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_quote_print_count\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2026-04-13T22:52:31.395Z\"},{\"calculated\":false,\"createdAt\":\"2025-05-12T19:03:25.269Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The number of prints a quote has received since the last communication with a customer\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"quotetrackinginformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Print Count Since Last Communication\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_quote_print_count_since_last_communication\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2026-04-13T22:52:31.395Z\"},{\"calculated\":true,\"calculationFormula\":\"if string(hs_status) equals 'VOID' then 'VOID'\\nelseif string(hs_status) equals 'ACCEPTED' then 'ACCEPTED'\\nelseif is_present(string(hs_sign_status)) and string(hs_sign_status) equals 'ESIGN_COUNTERSIGN_PENDING' then 'NEEDS_COUNTERSIGN'\\nelseif is_present(hs_quote_view_count) and hs_quote_view_count > 0 then if not (bool(hs_esign_enabled)) then 'VIEWED'\\nelseif bool(hs_esign_enabled) and is_present(string(hs_sign_status)) and string(hs_sign_status) equals 'ESIGN_PENDING' then 'VIEWED_PENDING_SIGNATURE' else 'VIEWED'\\nelseif is_present(hs_last_sent_date) then if not (bool(hs_esign_enabled)) then 'SENT'\\nelseif bool(hs_esign_enabled) and is_present(string(hs_sign_status)) and string(hs_sign_status) equals 'ESIGN_PENDING' then 'SENT_PENDING_SIGNATURE' else 'SENT'\\nelseif string(hs_status) equals 'APPROVED' or string(hs_status) equals 'APPROVAL_NOT_NEEDED' then if not (bool(hs_esign_enabled)) and not (is_present(string(hs_sign_status))) then 'PUBLISHED'\\nelseif bool(hs_esign_enabled) and is_present(string(hs_sign_status)) and string(hs_sign_status) equals 'ESIGN_PENDING' then 'PENDING_SIGNATURE' else 'PUBLISHED'\\nelseif string(hs_status) equals 'REJECTED' then 'CHANGES_REQUESTED'\\nelseif string(hs_status) equals 'PENDING_APPROVAL' then 'PENDING_APPROVAL'\\nelseif string(hs_status) equals 'DRAFT' then 'DRAFT' else 'DRAFT'\",\"createdAt\":\"2025-06-18T16:18:40.164Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"A representation of the quote's status throughout its lifetime. This has a hierarchy represented by the order of the property's possible values. Example: If a quote is both Viewed and Paid, then Paid will take priority.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"quoteinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Progression status\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_quote_progression_status\",\"options\":[{\"description\":\"This quote is a draft\",\"displayOrder\":0,\"hidden\":false,\"label\":\"Draft\",\"value\":\"DRAFT\"},{\"description\":\"This quote needs approval\",\"displayOrder\":1,\"hidden\":false,\"label\":\"Pending Approval\",\"value\":\"PENDING_APPROVAL\"},{\"description\":\"This quote was rejected by the approver and has requested changes\",\"displayOrder\":2,\"hidden\":false,\"label\":\"Changes Requested\",\"value\":\"CHANGES_REQUESTED\"},{\"description\":\"This quote has been published\",\"displayOrder\":3,\"hidden\":false,\"label\":\"Published\",\"value\":\"PUBLISHED\"},{\"description\":\"This published quote needs e-signature\",\"displayOrder\":4,\"hidden\":false,\"label\":\"Published - Pending signature\",\"value\":\"PENDING_SIGNATURE\"},{\"description\":\"This quote is awaiting acceptance\",\"displayOrder\":5,\"hidden\":false,\"label\":\"Pending Acceptance\",\"value\":\"PENDING_ACCEPTANCE\"},{\"description\":\"This quote has been sent\",\"displayOrder\":6,\"hidden\":false,\"label\":\"Published - Sent\",\"value\":\"SENT\"},{\"description\":\"This sent quote needs e-signature\",\"displayOrder\":7,\"hidden\":false,\"label\":\"Sent - Pending signature\",\"value\":\"SENT_PENDING_SIGNATURE\"},{\"description\":\"This quote was viewed\",\"displayOrder\":8,\"hidden\":false,\"label\":\"Published - Viewed\",\"value\":\"VIEWED\"},{\"description\":\"This viewed quote needs e-signature\",\"displayOrder\":9,\"hidden\":false,\"label\":\"Viewed - Pending signature\",\"value\":\"VIEWED_PENDING_SIGNATURE\"},{\"description\":\"This quote is awaiting countersign\",\"displayOrder\":10,\"hidden\":false,\"label\":\"Pending Countersignature\",\"value\":\"NEEDS_COUNTERSIGN\"},{\"description\":\"This quote was accepted\",\"displayOrder\":11,\"hidden\":false,\"label\":\"Accepted\",\"value\":\"ACCEPTED\"},{\"description\":\"This quote has been voided\",\"displayOrder\":12,\"hidden\":false,\"label\":\"Void\",\"value\":\"VOID\"}],\"type\":\"enumeration\",\"updatedAt\":\"2026-04-13T22:52:31.395Z\"},{\"calculated\":true,\"calculationFormula\":\"if is_present(bool(hs_archived)) and bool(hs_archived) then 'ARCHIVED'\\nelseif string(hs_status) equals 'DRAFT' then 'DRAFT'\\nelseif string(hs_status) equals 'PENDING_APPROVAL' then 'PENDING_APPROVAL'\\nelseif string(hs_status) equals 'REJECTED' then 'CHANGES_REQUESTED'\\nelseif string(hs_status) equals 'ACCEPTED' then 'ACCEPTED'\\nelseif string(hs_status) equals 'VOID' then 'VOID'\\nelseif (string(hs_status) equals 'APPROVAL_NOT_NEEDED' or string(hs_status) equals 'APPROVED') and is_present(bool(hs_locked)) and bool(hs_locked) and (not (is_present(bool(hs_expired))) or not (bool(hs_expired))) then 'PUBLISHED'\\nelseif (string(hs_status) equals 'APPROVAL_NOT_NEEDED' or string(hs_status) equal