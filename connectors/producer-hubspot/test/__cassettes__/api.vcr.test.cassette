)) then string_to_number(timestamp(hs_last_email_details)) endif)\",\"createdAt\":\"2019-08-06T02:43:01.851Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The date of the last email activity with the contact associated with the ticket.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"date\",\"formField\":false,\"groupName\":\"ticketinformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Last email date\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_last_email_date\",\"options\":[],\"type\":\"datetime\",\"updatedAt\":\"2025-05-06T23:39:24.725Z\"},{\"calculated\":false,\"createdAt\":\"2025-04-28T18:11:22.558Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The id and direction of the last non-forwarded email\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"text\",\"formField\":false,\"groupName\":\"ticketinformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Last email details\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_last_email_details\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2025-07-22T20:56:12.984Z\"},{\"calculated\":false,\"createdAt\":\"2024-11-12T23:06:14.877Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"text\",\"formField\":false,\"groupName\":\"ticketinformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Last Email Type\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_last_email_type\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2025-02-20T23:50:06.732Z\"},{\"calculated\":false,\"calculationFormula\":\"(if is_present(hs_last_message_received_at) then (if (if is_present(hs_last_message_sent_at) then hs_last_message_received_at > hs_last_message_sent_at else true) then true else false) else false)\",\"createdAt\":\"2023-04-18T19:20:54.002Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Whether the last message came from visitor\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"ticketinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Last message from visitor\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_last_message_from_visitor\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"True\",\"value\":\"true\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"False\",\"value\":\"false\"}],\"type\":\"bool\",\"updatedAt\":\"2023-04-18T19:20:54.002Z\"},{\"calculated\":true,\"createdAt\":\"2021-12-07T15:01:03.226Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The date of the last response from the visitor\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_rollup\",\"formField\":false,\"groupName\":\"ticketinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Last message received date\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_last_message_received_at\",\"options\":[],\"type\":\"datetime\",\"updatedAt\":\"2024-09-23T14:18:17.496Z\"},{\"calculated\":true,\"createdAt\":\"2021-12-02T22:27:22.847Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The date of the last response from an agent or bot\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_rollup\",\"formField\":false,\"groupName\":\"ticketinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Last response date\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"na