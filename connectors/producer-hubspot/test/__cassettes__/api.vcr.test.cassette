Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The date when ticket was last closed\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"date\",\"formField\":false,\"groupName\":\"ticket_activity\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Last Closed Date\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_last_closed_date\",\"options\":[],\"type\":\"datetime\",\"updatedAt\":\"2024-10-07T19:15:03.242Z\"},{\"calculated\":false,\"createdAt\":\"2026-03-02T11:17:34.128Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Last CSAT survey comment associated to this ticket\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_rollup\",\"formField\":false,\"groupName\":\"ticket_activity\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Last CSAT survey comment\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_last_csat_comment\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2026-03-02T11:17:34.128Z\"},{\"calculated\":false,\"createdAt\":\"2026-03-02T11:16:33.414Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The time that this contact last submitted a CSAT survey response.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_rollup\",\"formField\":false,\"groupName\":\"ticket_activity\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Last CSAT survey date\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_last_csat_date\",\"options\":[],\"type\":\"datetime\",\"updatedAt\":\"2026-03-02T11:16:33.414Z\"},{\"calculated\":false,\"createdAt\":\"2026-03-02T11:18:31.870Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Last CSAT rating rolled up from associated feedback submission\",\"displayOrder\":