led\",\"value\":\"DISABLED\"},{\"description\":\"If none of the user's personal inbox is enabled, and at least one of them is in Error state.\",\"displayOrder\":1,\"hidden\":false,\"label\":\"Error\",\"value\":\"ERROR\"},{\"description\":\"At least one of the user's personal connected email is enabled.\",\"displayOrder\":2,\"hidden\":false,\"label\":\"Enabled\",\"value\":\"ENABLED\"}],\"type\":\"enumeration\",\"updatedAt\":\"2024-03-22T17:55:26.459Z\"},{\"calculated\":false,\"dataSensitivity\":\"non_sensitive\",\"description\":\"The user who created this record. This value is set automatically by HubSpot.\",\"displayOrder\":-1,\"externalOptions\":true,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"user_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Created by user ID\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_created_by_user_id\",\"numberDisplayHint\":\"unformatted\",\"options\":[],\"type\":\"number\"},{\"calculated\":false,\"createdAt\":\"1970-01-01T00:00:00Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The date and time at which this object was created. This value is automatically set by HubSpot and may not be modified.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"date\",\"formField\":false,\"groupName\":\"user_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Created date\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_createdate\",\"options\":[],\"type\":\"datetime\",\"updatedAt\":\"2023-10-06T19:11:43.224Z\"},{\"calculated\":false,\"createdAt\":\"2025-02-05T20:59:56.664Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Signifies that this user was first initialized via the CRM rather than internal systems\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"booleancheckbox\",\"formField\":false,\"groupName\":\"access\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"CRM Initialized\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_crm_initialized\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"Yes\",\"value\":\"true\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"No\",\"value\":\"false\"}],\"type\":\"bool\",\"updatedAt\":\"2026-03-16T19:12:16.981Z\"},{\"calculated\":false,\"createdAt\":\"2023-01-27T16:15:12.985Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Users who are deactivated and no longer have access to this HubSpot account.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"booleancheckbox\",\"formField\":false,\"groupName\":\"access\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Deactivated\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_deactivated\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"Yes\",\"value\":\"true\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"No\",\"value\":\"false\"}],\"type\":\"bool\",\"updatedAt\":\"2024-06-04T15:21:53.969Z\"},{\"calculated\":true,\"calculationFormula\":\"if (is_present(string(hs_user_assigned_primary_team)) and is_present(string(hs_user_secondary_teams))) then concatenate(string(hs_user_assigned_primary_team), ';', string(hs_user_secondary_teams)) else string(hs_user_assigned_primary_team)\",\"createdAt\":\"2026-01-06T21:50:33.241Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The direct (primary and secondary) teams for this user\",\"displayOrder\":-1,\"externalOptions\":true,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"setup\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Team(s) - deprecated\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_direct_teams\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2026-01-20T21:58:11.996Z\"},{\"calculated\":false,\"createdAt\":\"2023-01-04T19:35:01.535Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The user's email address.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"text\",\"formField\":false,\"groupName\":\"user_information\",\"hasUniqueValue\":true,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Email\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_email\",\"options\":[],\"textDisplayHint\":\"email\",\"type\":\"string\",\"updatedAt\":\"2025-06-17T15:16:39.944Z\"},{\"calculated\":false,\"createdAt\":\"2025-12-02T16:18:43.254Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Whether or not the user is receiving HubSpot email notifications\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"booleancheckbox\",\"formField\":false,\"groupName\":\"user_activity\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Email Notifications Bounce Status\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_email_notifications_bounced\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"User is not receiving HubSpot email notifications\",\"value\":\"true\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"User is receiving HubSpot email notifications\",\"value\":\"false\"}],\"type\":\"bool\",\"updatedAt\":\"2026-08-04T17:21:46.552Z\"},{\"calculated\":false,\"createdAt\":\"2023-01-04T19:41:48.828Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The user's last or family name.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"text\",\"formField\":false,\"groupName\":\"user_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Last Name\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_family_name\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2023-07-10T17:22:13.004Z\"},{\"calculated\":false,\"createdAt\":\"2023-01-04T19:40:21.535Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The user's first or given name.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"text\",\"formField\":false,\"groupName\":\"user_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"First Name\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_given_name\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2023-07-10T17:18:24.566Z\"},{\"calculated\":false,\"createdAt\":\"2026-06-23T17:10:24.136Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Whether this user is displayed in most systems. This typically applies to agents or bots, but can include other types of users.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"booleancheckbox\",\"formField\":false,\"groupName\":\"user_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Hidden\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_hidden\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"Yes\",\"value\":\"true\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"No\",\"value\":\"false\"}],\"type\":\"bool\",\"updatedAt\":\"2026-06-23T17:10:24.136Z\"},{\"calculated\":false,\"createdAt\":\"2023-09-13T18:51:42.050Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Establishes whether or not this user is a HubSpot JITA user. These users are HubSpot employees that have temporary access to the portal for support or security purposes.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"booleancheckbox\",\"formField\":false,\"groupName\":\"user_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"HubSpot JITA User\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_hubspot_jita_user\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"Yes\",\"value\":\"true\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"No\",\"value\":\"false\"}],\"type\":\"bool\",\"updatedAt\":\"2023-09-13T18:51:42.050Z\"},{\"calculated\":false,\"createdAt\":\"2023-01-04T19:53:59.606Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The user's unique internal ID in HubSpot's centralized database. This is not portal-specific.\",\"displayOrder\":-1,\"externalOptions\":true,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"user_information\",\"hasUniqueValue\":true,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Internal User ID\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_internal_user_id\",\"numberDisplayHint\":\"unformatted\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2026-04-22T23:44:46.517Z\"},{\"calculated\":false,\"createdAt\":\"2023-06-23T18:45:12.278Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The time the user accepted their invite to the portal.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"date\",\"formField\":false,\"groupName\":\"user_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Invite Accepted Time\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_invite_accepted_time\",\"options\":[],\"type\":\"datetime\",\"updatedAt\":\"2023-06-23T18:45:12.278Z\"},{\"calculated\":false,\"createdAt\":\"2023-07-20T15:37:32.784Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Displays the status of the user's invite email\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"select\",\"formField\":false,\"groupName\":\"user_activity\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"invite_email_status\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_invite_email_status\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"Sent\",\"value\":\"sent\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"Not Sent\",\"value\":\"not_sent\"},{\"displayOrder\":2,\"hidden\":false,\"label\":\"Bounced\",\"value\":\"bounced\"},{\"displayOrder\":3,\"hidden\":false,\"label\":\"Delivered\",\"value\":\"delivered\"}],\"type\":\"enumeration\",\"updatedAt\":\"2024-03-22T16:34:33.972Z\"},{\"calculated\":true,\"calculationFormula\":\"(if is_present(bool(hs_deactivated)) and bool(hs_deactivated) then 'deactivated'\\nelse(if is_present(hs_invite_accepted_time) then 'invite_accepted'\\nelse(if is_present(string(hs_invite_email_status)) then (if string(hs_invite_email_status) equals 'bounced' then 'invite_bounced' else 'invite_pending') else 'invite_pending')))\",\"createdAt\":\"2023-07-27T18:25:52.706Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The user's invite status.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"user_activity\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Invite Status\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_invite_status\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"Deactivated\",\"value\":\"deactivated\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"Invite pending\",\"value\":\"invite_pending\"},{\"displayOrder\":2,\"hidden\":false,\"label\":\"Invite bounced\",\"value\":\"invite_bounced\"},{\"displayOrder\":3,\"hidden\":false,\"label\":\"Invite accepted\",\"value\":\"invite_accepted\"}],\"type\":\"enumeration\",\"upd