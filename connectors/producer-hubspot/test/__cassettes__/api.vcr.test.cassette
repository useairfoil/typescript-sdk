us) equals '4' then 0 endif\",\"createdAt\":\"2025-06-04T00:22:10.957Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"1 if ttfr is successfully reached, 0 if not, and nothing if ttfr is still active\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"ticketinformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Is Closed in Time to First Response Sla Count\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_is_closed_in_time_to_first_response_sla_count\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2026-04-01T15:04:43.697Z\"},{\"calculated\":false,\"createdAt\":\"2024-03-21T19:46:34.747Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Is latest message failed\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_rollup\",\"formField\":false,\"groupName\":\"ticketinformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Is latest message failed\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":false,\"readOnlyValue\":true},\"name\":\"hs_is_latest_message_failed\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"Yes\",\"value\":\"true\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"No\",\"value\":\"false\"}],\"type\":\"bool\",\"updatedAt\":\"2024-03-21T19:46:34.747Z\"},{\"calculated\":false,\"createdAt\":\"2024-08-29T19:07:24.831Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Is latest message hidden from all\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_rollup\",\"formField\":false,\"groupName\":\"ticketinformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Is latest message hidden from all\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":false,\"readOnlyValue\":true},\"name\":\"hs_is_l