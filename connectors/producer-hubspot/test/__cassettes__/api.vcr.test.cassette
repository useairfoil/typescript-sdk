r\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"hubspotmetrics\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Open amount in home currency\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_open_amount_in_home_currency\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2025-06-06T20:53:40.273Z\"},{\"calculated\":true,\"calculationFormula\":\"if bool(hs_is_closed) then 0 else time_between(createdate, 0)\",\"createdAt\":\"2024-06-12T05:34:12.696Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Create date populated only if this deal is open\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"dealscripted\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Open deal create date\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":false,\"readOnlyValue\":true},\"name\":\"hs_open_deal_create_date\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2025-10-17T16:09:27.141Z\"},{\"calculated\":false,\"dataSensitivity\":\"non_sensitive\",\"description\":\"The teams that are attributed to this record.\",\"displayOrder\":-1,\"externalOptions\":true,\"fieldType\":\"checkbox\",\"formField\":false,\"groupName\":\"dealinformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Owning Teams\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_owning_teams\",\"options\":[],\"type\":\"enumeration\"},{\"calculated\":false,\"createdAt\":\"2026-03-26T15:40:34.893Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Tech Win field is used to identify where we are in achieving a technical win. Tech Win occurs when HubSpot technically fulfills the customer’s specific needs, marking a pivotal point in the sales process.Set to \\\"In Progress\\\" by Partner when joining the first disco call. Set to \\\"Yes\\\" by Partner when prospect verbally agrees that HS satisfies their technical/ business needs. Set to \\\"No\\\" by Partner when HS is not a fit based on customer feedback. How this property gets set: Manual Entry by Partner Consumer: SalesProperty Create Date: March 19, 2026\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"select\",\"formField\":true,\"groupName\":\"dealinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Partner Tech Win\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":false,\"readOnlyValue\":false},\"name\":\"hs_partner_tech_win\",\"options\":[{\"description\":\"\",\"displayOrder\":0,\"hidden\":false,\"label\":\"In Progress\",\"value\":\"in_progress\"},{\"description\":\"\",\"displayOrder\":1,\"hidden\":false,\"label\":\"Yes\",\"value\":\"Yes\"},{\"description\":\"\",\"displayOrder\":2,\"hidden\":false,\"label\":\"No\",\"value\":\"No\"},{\"description\":\"\",\"displayOrder\":3,\"hidden\":false,\"label\":\"Incomplete\",\"value\":\"Incomplete\"}],\"type\":\"enumeration\",\"updatedAt\":\"2026-03-26T15:40:34.893Z\"},{\"calculated\":false,\"createdAt\":\"2022-07-25T20:58:45.636Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The object ID of the current pinned engagement. This will only be shown if there is already an association to the engagement.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"dealinformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Pinned Engagement ID\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_pinned_engagement_id\",\"numberDisplayHint\":\"formatted\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2026-01-20T21:07:17.015Z\"},{\"calculated\":false,\"calculationFormula\":\"(if (is_present(hs_likelihood_to_close) and hs_likelihood_to_close >= 0 and hs_likelihood_to_close <= 1 and is_present(amount)) then (hs_likelihood_to_close * amount) endif)\",\"createdAt\":\"2020-02-07T22:33:43.508Z\",\"currencyPropertyName\":\"deal_currency_code\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Returns the multiplication of the deal amount times the predicted likelihood of the deal to close by the close date.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"dealinformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"The predicted deal amount\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_predicted_amount\",\"options\":[],\"showCurrencySymbol\":true,\"type\":\"number\",\"updatedAt\":\"2026-07-23T16:24:22.962Z\"},{\"calculated\":false,\"calculationFormula\":\"if (is_present(hs_likelihood_to_close) and hs_likelihood_to_close >= 0 and hs_likelihood_to_close <= 1 and is_present(amount_in_home_currency)) then (hs_likelihood_to_close * amount_in_home_currency) endif\",\"createdAt\":\"2020-02-07T22:38:42.351Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Returns the multiplication of the deal amount in your company's currency times the predicted likelihood of the deal to close by the close date.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"dealinformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"The predicted deal amount in your company's currency\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_predicted_amount_in_home_currency\",\"options\":[],\"showCurrencySymbol\":true,\"type\":\"number\",\"updatedAt\":\"2026-07-23T16:24:58.340Z\"},{\"calculated\":false,\"createdAt\":\"2026-09-22T17:29:45.606Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Tracks whether a re-evaluated Price Book change on this deal still needs the seller to act (Pending) or has been addressed (Resolved).\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"select\",\"formField\":false,\"groupName\":\"dealinformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Price book reassignment status\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_price_book_reassignment_status\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"Pending\",\"value\":\"PENDING\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"Resolved\",\"value\":\"RESOLVED\"}],\"type\":\"enumeration\",\"updatedAt\":\"2026-09-22T17:29:45.606Z\"},{\"calculated\":false,\"createdAt\":\"2025-05-12T13:57:40.385Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Object Id of the Primary Associated Company.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_rollup\",\"formField\":false,\"groupName\":\"dealinformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Primary Associated Company\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_primary_associated_company\",\"numberDisplayHint\":\"unformatted\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2026-09-01T09:01:09.353Z\"},{\"calculated\":false,\"createdAt\":\"2026-04-06T17:43:39.591Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Timestamp of when the deal's amount, line items, and global terms were updated from a newly created primary quote association.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"date\",\"formField\":false,\"groupName\":\"deal_activity\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Primary quote data updated at\",\"modificationMetadata\"