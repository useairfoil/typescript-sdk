rring Revenue\",\"value\":\"ARR\"},{\"displayOrder\":2,\"hidden\":false,\"label\":\"Monthly Recurring Revenue\",\"value\":\"MRR\"},{\"displayOrder\":3,\"hidden\":false,\"label\":\"Custom\",\"value\":\"CUSTOM\"}],\"type\":\"enumeration\",\"updatedAt\":\"2023-06-20T22:37:00.799Z\"},{\"calculated\":false,\"createdAt\":\"2024-10-02T22:53:57.788Z\",\"currencyPropertyName\":\"hs_deal_registration_mrr_currency_code\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"MRR of the quote purchased for this Shared Deal.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"deal_activity\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"HubSpot Shared Deal MRR\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_deal_registration_mrr\",\"options\":[],\"showCurrencySymbol\":true,\"type\":\"number\",\"updatedAt\":\"2024-10-03T21:24:40.667Z\"},{\"calculated\":false,\"createdAt\":\"2024-10-02T22:50:57.258Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Currency code for the MRR of the quote purchased for this Shared Deal.\",\"displayOrder\":-1,\"externalOptions\":true,\"fieldType\":\"select\",\"formField\":false,\"groupName\":\"deal_activity\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"HubSpot Shared Deal MRR Currency Code\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_deal_registration_mrr_currency_code\",\"options\":[],\"showCurrencySymbol\":false,\"type\":\"enumeration\",\"updatedAt\":\"2024-10-03T21:24:20.413Z\"},{\"calculated\":false,\"createdAt\":\"2023-10-18T19:56:30.580Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The predictive deal score calculated by Hubspot AI to score the deal health\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"dealin