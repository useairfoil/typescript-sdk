red the system\",\"displayOrder\":17,\"externalOptions\":false,\"fieldType\":\"date\",\"formField\":false,\"groupName\":\"contactinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Create Date\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"createdate\",\"options\":[],\"type\":\"datetime\",\"updatedAt\":\"2024-09-05T17:14:04.747Z\"},{\"calculated\":false,\"createdAt\":\"2025-01-21T17:43:46.402Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"True when contact is enrolled in a workflow.\",\"displayOrder\":1,\"externalOptions\":false,\"fieldType\":\"booleancheckbox\",\"formField\":false,\"groupName\":\"contact_activity\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Currently in workflow (discontinued)\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"currentlyinworkflow\",\"options\":[{\"description\":\"\",\"displayOrder\":0,\"hidden\":false,\"label\":\"True\",\"value\":\"true\"},{\"description\":\"\",\"displayOrder\":1,\"hidden\":false,\"label\":\"False\",\"value\":\"false\"}],\"type\":\"enumeration\",\"updatedAt\":\"2025-04-18T15:55:56.565Z\"},{\"calculated\":false,\"createdAt\":\"2020-06-30T15:57:37.176Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Contact's date of birth. Required for the Facebook Ads Integration. Automatically synced from the Lead Ads tool.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"text\",\"formField\":true,\"groupName\":\"facebook_ads_properties\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Date of birth\",\"modificationMetadata\":{\"archivable\":false,\"readOnlyDefinition\":false,\"readOnlyValue\":false},\"name\":\"date_of_birth\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2024-09-11T17:29:11.316Z\"},{\"calculated\":true,\"calculationFormula\":\"(if closedate >= createdate then (1 + round_down(((closedate - createdate) / 86400000), 0)) endif)\",\"createdAt\":\"2020-06-30T15:57:37.161Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Count of days elapsed between creation and being closed as a customer. Set automatically.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"deal_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Days To Close\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"days_to_close\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2023-05-01T20:02:33.973Z\"},{\"calculated\":false,\"createdAt\":\"2020-06-30T15:57:37.289Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Contact's degree. Required for the Facebook Ads Integration. Automatically synced from the Lead Ads tool.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"text\",\"formField\":true,\"groupName\":\"facebook_ads_properties\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Degree\",\"modificationMetadata\":{\"archivable\":false,\"readOnlyDefinition\":false,\"readOnlyValue\":false},\"name\":\"degree\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2024-09-11T17:29:24.127Z\"},{\"calculated\":false,\"createdAt\":\"2019-08-06T02:41:08.204Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"A contact's email address\",\"displayOrder\":3,\"externalOptions\":false,\"fieldType\":\"text\",\"formField\":true,\"groupName\":\"contactinformation\",\"hasUniqueValue\":true,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Email\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"email\",\"options\":[],\"textDisplayHint\":\"email\",\"type\":\"string\",\"updatedAt\":\"2025-10-28T17:42:40.714Z\"},{\"calculated\":false,\"createdAt\":\"2020-06-30T15:57:37.033Z\",\"dataSen