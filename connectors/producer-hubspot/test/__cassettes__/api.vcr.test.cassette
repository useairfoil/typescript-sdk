"updatedAt\":\"2025-07-09T18:44:36.476Z\"},{\"calculated\":true,\"calculationFormula\":\"(if is_present(hs_exchange_rate) then hs_amount_billed * hs_exchange_rate else hs_amount_billed)\",\"createdAt\":\"2024-06-06T14:12:30.243Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The amount billed on the invoice in the company currency\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"invoiceinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Amount billed in company currency\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_amount_billed_in_company_currency\",\"options\":[],\"showCurrencySymbol\":true,\"type\":\"number\",\"updatedAt\":\"2024-11-25T17:55:27.610Z\"},{\"calculated\":true,\"calculationFormula\":\"round_nearest(hs_amount_billed - hs_taxes_total, currency_decimal_places(string(hs_currency)))\",\"createdAt\":\"2024-08-14T17:16:32.840Z\",\"currencyPropertyName\":\"hs_currency\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The amount billed on the invoice before tax\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"invoiceinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Amount billed (pre-tax)\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_amount_billed_pre_tax\",\"options\":[],\"showCurrencySymbol\":true,\"type\":\"number\",\"updatedAt\":\"2024-12-31T18:55:06.874Z\"},{\"calculated\":true,\"calculationFormula\":\"if string(hs_invoice_status) equals 'voided' then 0 else round_nearest(hs_amount_billed - hs_balance_due, currency_decimal_places(string(hs_currency)))\",\"createdAt\":\"2023-11-20T05:34:13.833Z\",\"currencyPropertyName\":\"hs_currency\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The total value of non-failed payments associated to the invoice.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"invoiceinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Amount paid\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_amount_paid\",\"options\":[],\"showCurrencySymbol\":true,\"type\":\"number\",\"updatedAt\":\"2025-11-26T16:10:51.014Z\"},{\"calculated\":true,\"calculationFormula\":\"(if is_present(hs_exchange_rate) then hs_amount_paid * hs_exchange_rate else hs_amount_paid)\",\"createdAt\":\"2024-06-05T20:54:59.106Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The total value of non-failed payments associated to the invoice in the company currency\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"invoiceinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Amount paid in company currency\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_amount_paid_in_company_currency\",\"options\":[],\"showCurrencySymbol\":true,\"type\":\"number\",\"updatedAt\":\"2024-11-25T17:56:03.943Z\"},{\"calculated\":false,\"createdAt\":\"2023-11-20T00:52:41.426Z\",\"currencyPropertyName\":\"hs_currency\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The total value of processing payments associated to the invoice.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"invoiceinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Amount processing\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_amount_processing\",\"options\":[],\"showCur