nt\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Cross-sell Opportunity\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_cross_sell_opportunity\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"Yes\",\"value\":\"true\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"No\",\"value\":\"false\"}],\"type\":\"bool\",\"updatedAt\":\"2026-03-23T17:16:35.156Z\"},{\"calculated\":true,\"calculationFormula\":\"(max(0, (closedate - createdate)) / 86400000)\",\"createdAt\":\"2023-08-07T15:27:11.457Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The number of days the deal took to close, without rounding\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"dealinformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Days to close (without rounding)\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_days_to_close_raw\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2025-10-17T16:09:27.141Z\"},{\"calculated\":false,\"createdAt\":\"2019-08-06T02:41:53.235Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Specifies how deal amount should be calculated from line items\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"radio\",\"formField\":false,\"groupName\":\"dealinformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Deal amount calculation preference\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyOptions\":true,\"readOnlyValue\":false},\"name\":\"hs_deal_amount_calculation_preference\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"Total Contract Value\",\"value\":\"TCV\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"Annual Recurring Revenue\",\"value\":\"ARR\"},{\"displayOrde