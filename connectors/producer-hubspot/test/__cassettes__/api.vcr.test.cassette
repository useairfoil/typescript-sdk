r\":0,\"hidden\":false,\"label\":\"Available\",\"value\":\"available\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"Away\",\"value\":\"away\"}],\"type\":\"enumeration\",\"updatedAt\":\"2024-08-30T15:23:59.218Z\"},{\"calculated\":false,\"createdAt\":\"2025-07-18T17:39:06.388Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Describes the user away status timer\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"text\",\"formField\":false,\"groupName\":\"work_preferences\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Away Status Timer\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_away_status_timer\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2026-04-03T15:10:16.861Z\"},{\"calculated\":false,\"createdAt\":\"2023-08-02T18:46:55.707Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Personal calendar connected to use HubSpot Meetings, calendar sync and scheduling pages.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"booleancheckbox\",\"formField\":false,\"groupName\":\"user_activity\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Calendar Status\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_calendar_connection_status\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"Connected\",\"value\":\"true\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"Disconnected\",\"value\":\"false\"}],\"type\":\"bool\",\"updatedAt\":\"2025-03-11T21:38:37.824Z\"},{\"calculated\":false,\"createdAt\":\"2023-08-03T13:31:15.776Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Calendar sync logs new meetings from their primary calendar to existing contacts in HubSpot.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"booleancheckbox\",\"formField\":false,\"groupName\":\"user_information\",\"hasUniqueValu