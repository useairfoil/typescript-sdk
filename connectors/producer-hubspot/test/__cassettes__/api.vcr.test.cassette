_customer\",\"numberDisplayHint\":\"duration\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2026-03-06T21:17:26.729Z\"},{\"calculated\":false,\"calculationFormula\":\"time_between(hs_v2_date_entered_marketingqualifiedlead, hs_v2_date_entered_customer)\",\"createdAt\":\"2020-12-11T19:43:56.759Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\" How long it takes for a contact to move from the HubSpot marketing qualified lead stage to the HubSpot customer stage.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"contactinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Time to move from marketing qualified lead to customer\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":false,\"readOnlyValue\":false},\"name\":\"hs_time_to_move_from_marketingqualifiedlead_to_customer\",\"numberDisplayHint\":\"duration\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2026-03-06T21:17:26.729Z\"},{\"calculated\":false,\"calculationFormula\":\"time_between(hs_v2_date_entered_opportunity, hs_v2_date_entered_customer)\",\"createdAt\":\"2020-12-11T15:37:37.150Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\" How long it takes for a contact to move from the HubSpot opportunity stage to the HubSpot customer stage.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"contactinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Time to move from opportunity to customer\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":false,\"readOnlyValue\":false},\"name\":\"hs_time_to_move_from_opportunity_to_customer\",\"numberDisplayHint\":\"duration\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2026-03-06T21:17:26.729Z\"},{\"calculated\":false,\"calculationFormula\":\"time_between(hs_v2_date_entered_salesqualifie