originating_email_engagement_id\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2022-08-18T12:57:43.210Z\"},{\"calculated\":true,\"createdAt\":\"2022-08-22T17:06:41.051Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The channel the conversation is in\",\"displayOrder\":-1,\"externalOptions\":true,\"fieldType\":\"calculation_rollup\",\"formField\":false,\"groupName\":\"ticketinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Originating channel type\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_originating_generic_channel_id\",\"options\":[],\"type\":\"enumeration\",\"updatedAt\":\"2025-02-18T21:03:29.697Z\"},{\"calculated\":false,\"createdAt\":\"2025-02-11T13:07:39.308Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Was the ticket created by sending an outbound communication from an object record page?\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"booleancheckbox\",\"formField\":false,\"groupName\":\"ticketinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Outbound ticket\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_outbound_ticket\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"Yes\",\"value\":\"true\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"No\",\"value\":\"false\"}],\"type\":\"bool\",\"updatedAt\":\"2025-10-02T18:13:49.462Z\"},{\"calculated\":true,\"calculationFormula\":\"if hs_overall_visitor_messages_sentiment_score >= 0 and hs_overall_visitor_messages_sentiment_score <= 40 then 'Negative'\\nelseif hs_overall_visitor_messages_sentiment_score > 40 and hs_overall_visitor_messages_sentiment_score < 60 then 'Neutral' else 'Positive'\",\"createdAt\":\"2025-04-01T15:57:46.501Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"No new values after 05/01/2026 - Overall sentiment of the ticket (Positive, Neutral, or Negative), determined by the average of AI-analyzed sentiment scores from all visitor messages. An average score of 60-100 is Positive, 41-59 is Neutral, and 0-40 is Negative.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"ticket_ai_enrichment\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"(Deprecated) Average ticket sentiment\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_overall_visitor_messages_sentiment\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"Positive\",\"value\":\"Positive\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"Neutral\",\"value\":\"Neutral\"},{\"displayOrder\":2,\"hidden\":false,\"label\":\"Negative\",\"value\":\"Negative\"}],\"type\":\"enumeration\",\"updatedAt\":\"2026-04-27T13:25:55.468Z\"},{\"calculated\":false,\"createdAt\":\"2025-01-30T17:51:22.550Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The average sentiment score (0-100) of all visitor messages on a ticket. Each message's sentiment is individually analyzed by AI, and this property displays the mean average of those individual scores. Higher scores indicate a more positive overall sentiment.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"ticket_ai_enrichment\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Average ticket sentiment score\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_overall_visitor_messages_sentiment_score\",\"numberDisplayHint\":\"unformatted\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2025-04-04T13:14:19.894Z\"},{\"calculated\":false,\"dataSensitivity\":\"non_sensitive\",\"description\":\"The teams that are attributed to this record.\",\"displayOrder\":-