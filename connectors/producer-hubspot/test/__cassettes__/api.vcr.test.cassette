abel\":\"Currency Exchange Rate\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_currency_exchange_rate\",\"numberDisplayHint\":\"formatted\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2025-10-17T16:09:27.141Z\"},{\"calculated\":false,\"calculationFormula\":\"if string(hs_kpi_object_type_id) equals '0-3' then string(hs_pipelines) else ''\",\"createdAt\":\"2023-06-26T20:03:17.853Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"A serialized list of DEAL pipeline IDs used to filter the KPI value calculation.\",\"displayOrder\":-1,\"externalOptions\":true,\"fieldType\":\"select\",\"formField\":false,\"groupName\":\"goal_target_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Deal pipelines\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":false,\"readOnlyValue\":false},\"name\":\"hs_deal_pipeline_ids\",\"options\":[],\"type\":\"enumeration\",\"updatedAt\":\"2025-10-17T16:09:27.141Z\"},{\"calculated\":false,\"createdAt\":\"2021-05-13T19:34:25.489Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The frequency of goal edit update notifications\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"select\",\"formField\":false,\"groupName\":\"goal_target_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Edit updates notification frequency\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":false,\"readOnlyValue\":false},\"name\":\"hs_edit_updates_notification_frequency\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"Daily\",\"value\":\"daily\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"Weekly\",\"value\":\"weekly\"},{\"displayOrder\":2,\"hidden\":false,\"label\":\"Monthly\",\"value\":\"monthly\"},{\"displayOrder\":3,\"hidden\":false,\"label\":\"Quarterly\",\"value\":\"quarterly\"},{\"displayOrder\":4,\"hidden\":false,\"label\":\"Yearly\",\"value\":\"yearly\"}],\"type\":\"enumeration\",\"updatedAt\":\"2025-10-17T16:09:27.141Z\"},{\"calculated\":false,\"createdAt\":\"2025-02-11T18:17:37.068Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Indicates the actual start of the time range to filter data for the KPI calculation of marketing assets such as CAMPAIGN.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"date\",\"formField\":false,\"groupName\":\"goal_target_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Effective Marketing KPI Start Datetime\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_effective_marketing_kpi_start_datetime\",\"options\":[],\"type\":\"datetime\",\"updatedAt\":\"2025-10-23T09:21:40.516Z\"},{\"calculated\":false,\"createdAt\":\"2021-05-13T19:02:05.684Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The last day covered by the Goal Target's date range.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"date\",\"formField\":false,\"groupName\":\"goal_target_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"End date\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":false,\"readOnlyValue\":false},\"name\":\"hs_end_date\",\"options\":[],\"type\":\"date\",\"updatedAt\":\"2025-10-17T16:09:27.141Z\"},{\"calculated\":false,\"createdAt\":\"2022-06-06T13:51:36.432Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The last day covered by the Goal Target's date range.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"date\",\"formField\":false,\"groupName\":\"goal_target_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"End datetime\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":false,\"readOnlyValue\":false},\"name\":\"hs_end_datetime\",\"options\":[],\"type\":\"datetime\",\"updatedAt\":\"2025-10-17T16:09:27.141Z\"},{\"calculated\":false,\"createdAt\":\"2024-09-23T20:17:47.063Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"User ids of extra team members associated with this goal\",\"displayOrder\":-1,\"externalOptions\":true,\"fieldType\":\"checkbox\",\"formField\":false,\"groupName\":\"goal_target_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Extra team member user Ids\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":false,\"readOnlyValue\":false},\"name\":\"hs_extra_team_member_user_ids\",\"options\":[],\"type\":\"enumeration\",\"updatedAt\":\"2025-10-17T16:09:27.141Z\"},{\"calculated\":false,\"createdAt\":\"2021-10-25T22:04:49.416Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Represents the number of months the fiscal year is away from a standard calendar year (0 means the fiscal year starts in January).\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"goal_target_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Fiscal year offset\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":false,\"readOnlyValue\":false},\"name\":\"hs_fiscal_year_offset\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2025-10-17T16:09:27.141Z\"},{\"calculated\":false,\"createdAt\":\"2024-06-18T12:35:34.036Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Optional forecast type id used to set the goal\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"goal_target_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Forecast type id\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":false,\"readOnlyValue\":false},\"name\":\"hs_forecast_type_id\",\"numberDisplayHint\":\"unformatted\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2025-10-17T16:09:27.141Z\"},{\"calculated\":true,\"calculationFormula\":\"if is_present(string(hs_kpi_display_unit)) then concatenate(string(hs_kpi_object_type_id), '-', string(hs_kpi_property_name), '-', string(hs_kpi_metric_type), '-', string(hs_kpi_display_unit), '-', string(hs_kpi_time_period_property), '-', string(hs_kpi_tracking_method), '-', string(hs_kpi_filter_groups_for_key_grouping)) else concatenate(string(hs_kpi_object_type_id), '-', string(hs_kpi_property_name), '-', string(hs_kpi_metric_type), '-', string(hs_kpi_time_period_property), '-', string(hs_kpi_tracking_method), '-', string(hs_kpi_filter_groups_for_key_grouping))\",\"createdAt\":\"2024-01-09T22:05:45.609Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Calculated key based on several goal kpi properties which define a goal. Example goal definition key: 0-3-amount_in_home_currency-SUM-hs_closed_date-[]-HIGHER_IS_BETTER\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"goal_target_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Goal Definition Key\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_goal_definition_key\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2025-10-17T16:09:27.141Z\"},{\"calculated\":true,\"calculationFormula\":\"if string(hs_assignee_type) equals 'teams' then concatenate(string(hs_group_correlation_uuid), '-', number_to_string(hs_assignee_team_id)) else ''\",\"createdAt\":\"2024-01-22T20:21:49.438Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Calculated key based used for aggregations on the group correlation uuid, and team id of a goal. Example goal definition key: a123-b231-c123-teamId\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"goal_target_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Goal Definition Key with Team\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_goal_definition_key_with_team\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2025-10-17T16:12:38.770Z\"},{\"calculated\":true,\"calculationFormula\":\"if string(hs_assignee_type) equals 'users' then concatenate(string(hs_group_correlation_uuid), '-', number_to_string(hs_assignee_user_id)) else ''\",\"createdAt\":\"2024-01-22T20:12:07.392Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Calculated key based on the group correlation uuid including the user id of a goal. Example goal definition key: a123-b321-c123-userId1\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"goal_target_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Goal Definition Key with User\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_goal_definition_key_with_user\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2025-10-17T16:12:38.770Z\"},{\"calculated\":false,\"createdAt\":\"2021-11-17T20:30:48.756Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The name of the goal.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"text\",\"formField\":false,\"groupName\":\"goal_target_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Goal name\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":false,\"readOnlyValue\":false},\"name\":\"hs_goal_name\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2025-10-17T16:12:38.770Z\"},{\"calculated\":false,\"createdAt\":\"2023-02-03T22:02:04.205Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Currency code for the goal target\",\"displayOrder\":-1,\"externalOptions\":true,\"field