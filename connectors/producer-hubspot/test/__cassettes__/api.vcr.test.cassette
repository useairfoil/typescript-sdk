29T22:46:03.893Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The team IDs of all default and custom owner properties for this record.\",\"displayOrder\":-1,\"externalOptions\":true,\"fieldType\":\"checkbox\",\"formField\":false,\"groupName\":\"goal_target_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"All team IDs\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_all_team_ids\",\"options\":[],\"type\":\"enumeration\",\"updatedAt\":\"2024-11-22T20:36:23.403Z\"},{\"calculated\":false,\"createdAt\":\"2025-07-25T15:12:10.558Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"This property is set when the goal is created at a portal level. This can also be used in the future for Multi-Account features.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"goal_target_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Assignee Portal ID\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_assignee_portal_id\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2025-11-14T15:26:10.826Z\"},{\"calculated\":false,\"createdAt\":\"2025-08-12T13:01:39.464Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Name of the property that represents the assignee ID of a goal\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"text\",\"formField\":false,\"groupName\":\"goal_target_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Assignee property name\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":false,\"readOnlyValue\":false},\"name\":\"hs_assignee_property_name\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2025-10-17T16:09:27.141Z\"},{\"calculated\":false,\"createdAt\":\"2022-01-11T01:05:10.402Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The team ID of the assigned team of the goal (unpopulated if the goal is not team-assigned or team-by-user-assigned)\",\"displayOrder\":-1,\"externalOptions\":true,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"goal_target_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Assignee team ID\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_assignee_team_id\",\"numberDisplayHint\":\"unformatted\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2025-10-17T16:09:27.141Z\"},{\"calculated\":false,\"calculationFormula\":\"if is_present(hs_assignee_user_id) then 'users'\\nelseif is_present(hs_assignee_team_id) then 'teams'\\nelseif is_present(hs_assignee_portal_id) then 'portal' else ''\",\"createdAt\":\"2023-12-07T15:13:15.479Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Goal assignee type calculated field based on the assigned user or team ids on the goal\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"select\",\"formField\":false,\"groupName\":\"goal_target_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Assignee type\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_assignee_type\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"Teams\",\"value\":\"teams\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"Users\",\"value\":\"users\"},{\"displayOrder\":2,\"hidden\":false,\"label\":\"Portal\",\"value\":\"portal\"}],\"type\":\"enumeration\",\"updatedAt\":\"2025-10-17T16:09:27.141Z\"},{\"calculated\":false,\"createdAt\":\"2022-01-09T03:00:46.197Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The user ID of the assigned user of the goal (unpopulated if the goal is not user-assigned)\",\"displayOrder\":-1,\"externalOptions\":true,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"goal_target_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Assignee user ID\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_assignee_user_id\",\"numberDisplayHint\":\"unformatted\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2025-10-17T16:09:27.141Z\"},{\"calculated\":false,\"createdAt\":\"2022-03-02T18:49:28.547Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"List of marketing campaign asset ids\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"checkbox\",\"formField\":false,\"groupName\":\"goal_target_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Campaign asset ids\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":false,\"readOnlyValue\":false},\"name\":\"hs_campaign_asset_ids\",\"options\":[],\"type\":\"enumeration\",\"updatedAt\":\"2025-10-17T16:09:27.141Z\"},{\"calculated\":false,\"createdAt\":\"2022-03-15T00:20:30.142Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The lifecycle stage selected for the contact lifecycle goal\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"text\",\"formField\":false,\"groupName\":\"goal_target_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Contact lifecycle stage\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_contact_lifecycle_stage\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2025-10-17T16:09:27.141Z\"},{\"calculated\":false,\"dataSensitivity\":\"non_sensitive\",\"description\":\"The user who created this record. This value is set automatically by HubSpot.\",\"displayOrder\":-1,\"externalOptions\":true,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"goal_target_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefi