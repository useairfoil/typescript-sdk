{\"displayOrder\":2,\"hidden\":false,\"label\":\"None\",\"value\":\"none\"},{\"displayOrder\":3,\"hidden\":false,\"label\":\"QuickBooks Online\",\"value\":\"quickbooks\"},{\"displayOrder\":4,\"hidden\":false,\"label\":\"Xero\",\"value\":\"xero\"},{\"displayOrder\":5,\"hidden\":false,\"label\":\"Manually recorded\",\"value\":\"manually_recorded\"}],\"type\":\"enumeration\",\"updatedAt\":\"2026-02-24T14:58:48.983Z\"},{\"calculated\":false,\"createdAt\":\"2022-07-15T20:23:46.596Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Determines whether a record can be edited by a user.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"booleancheckbox\",\"formField\":false,\"groupName\":\"commerce_payment_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Read only object\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_read_only\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"True\",\"value\":\"true\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"False\",\"value\":\"false\"}],\"type\":\"bool\",\"updatedAt\":\"2024-08-26T23:22:44.096Z\"},{\"calculated\":false,\"createdAt\":\"2023-10-23T18:21:52.506Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The reference number associated with the external payment\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"text\",\"formField\":false,\"groupName\":\"commerce_payment_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Reference number\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_reference_number\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2025-06-02T21:07:21.084Z\"},{\"calculated\":false,\"calculationFormula\":\"if string(hs_commerce_payment_method) equals 'KLARNA' then (hs_initiated_date + (180 * 24 * 60 * 60 * 1000))\\nelseif string(hs_commerce_payment_method) equals 'AFFIRM' then (hs_initiated_date + (120 * 24 * 60 * 60 * 1000))\\nelseif string(hs_payment_method_type) equals 'ach' then (hs_initiated_date + (180 * 24 * 60 * 60 * 1000)) else null\",\"createdAt\":\"2023-02-23T21:12:03.386Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The date after which refunds can no longer be initiated for the Payment.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"commerce_payment_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Refund deadline date\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_refund_deadline\",\"options\":[],\"type\":\"datetime\",\"updatedAt\":\"2026-07-13T18:02:05.911Z\"},{\"calculated\":true,\"calculationFormula\":\"(if not (bool(hs_is_refundable)) then (if string(hs_latest_status) equals 'processing' then 'payment_processing'\\nelse(if string(hs_latest_status) equals 'failed' then 'payment_failed'\\nelse(if string(hs_latest_status) equals 'refunded' then 'fully_refunded'\\nelse(if string(hs_latest_status) equals 'processing_refund' then 'refund_processing'\\nelse(if string(hs_latest_status) equals 'disputed_lost' or string(hs_latest_status) equals 'disputed_action_required' or string(hs_latest_status) equals 'disputed_awaiting_decision' then 'dispute_not_refundable'\\nelse(if NOW > hs_refund_deadline then 'refund_deadline_exceeded' endif)))))) endif)\",\"createdAt\":\"2023-02-23T21:13:00.223Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The reason why the refund is disabled.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"commerce_payment_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Refund disabled reason\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_refund_disabled_reason\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"Payment processing\",\"value\":\"payment_processing\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"Payment failed\",\"value\":\"payment_failed\"},{\"displayOrder\":2,\"hidden\":false,\"label\":\"Refund processing\",\"value\":\"refund_processing\"},{\"displayOrder\":3,\"hidden\":false,\"label\":\"Fully refunded\",\"value\":\"fully_refunded\"},{\"displayOrder\":4,\"hidden\":false,\"label\":\"Refund deadline exceeded\",\"value\":\"refund_deadline_exceeded\"},{\"displayOrder\":5,\"hidden\":false,\"label\":\"Dispute not refundable\",\"value\":\"dispute_not_refundable\"}],\"type\":\"enumeration\",\"updatedAt\":\"2025-05-12T22:39:24.892Z\"},{\"calculated\":false,\"createdAt\":\"2022-02-10T16:14:02.958Z\",\"currencyPropertyName\":\"hs_currency_code\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The total amount refunded to the customer.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"commerce_payment_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Refunded amount\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_refunds_amount\",\"options\":[],\"showCurrencySymbol\":true,\"type\":\"number\",\"updatedAt\":\"2025-06-02T21:07:52.543Z\"},{\"calculated\":false,\"calculationFormula\":\"hs_refunds_amount * hs_presentment_to_portal_currency_dated_exchange_rate\",\"createdAt\":\"2023-04-20T14:30:12.435Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The total amount refunded to the customer in the portal's default currency.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"commerce_payment_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Refunded amount in company currency\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_refunds_amount_in_portal_currency\",\"options\":[],\"showCurrencySymbol\":true,\"type\":\"number\",\"updatedAt\":\"2024-11-18T15:08:29.199Z\"},{\"calculated\":true,\"calculationFormula\":\"(if is_present(hs_presentment_to_settlement_currency_exchange_rate) then hs_refunds_amount * hs_presentment_to_settlement_currency_exchange_rate else hs_refunds_amount)\",\"createdAt\":\"2025-01-09T20:07:45.631Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The total amount refunded to the customer in the settlement currency.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"commerce_payment_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Refunded amount in settlement currency\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_refunds_amount_in_settlement_currency\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2025-01-09T20:07:45.631Z\"},{\"calculated\":false,\"createdAt\":\"2025-10-09T17:54:09.439Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The number of manual collection attempts remaining for this payment. Decreases by 1 with each manual collection attempt made\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"commerce_payment_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Remaining manual collection attempts\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_remaining_manual_collection_attempts\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2026-03-26T19:21:00.511Z\"},{\"calculated\":false,\"createdAt\":\"2025-12-16T23:15:18.754Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The reason for why manual and auto retries are disabled for this payment. Only applicable if retries were enabled prior to being disabled.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"select\",\"formField\":false,\"groupName\":\"commerce_payment_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Retries disabled reason\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_retries_disabled_reason\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"SUBSCRIPTION_PAUSED\",\"value\":\"subscription_paused\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"SUBSCRIPTION_CANCELED\",\"value\":\"subscription_canceled\"},{\"displayOrder\":2,\"hidden\":false,\"label\":\"INVOICE_VOIDED\",\"value\":\"invoice_voided\"},{\"displayOrder\":3,\"hidden\":false,\"label\":\"INVOICE_MANUALLY_PAID\",\"value\":\"invoice_manually_paid\"}],\"type\":\"enumeration\",\"updatedAt\":\"2026-03-26T19:21:12.422Z\"},{\"calculated\":false,\"createdAt\":\"2023-10-11T15:37:33.140Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The currency code that the merchant's payments will settle in.\",\"displayOrder\":-1,\"externalOptions\":true,\"fieldType\":\"select\",\"formField\":false,\"groupName\":\"commerce_payment_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Settlement currency code\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_settlement_currency_code\",\"options\":[],\"type\":\"enumeration\",\"updatedAt\":\"2025-06-02T21:08:21.102Z\"},{\"calculated\":false,\"dataSensitivity\":\"non_sensitive\",\"description\":\"Additional teams whose users can access the record based on their permissions. This can be set manually or through Workflows or APIs.\",\"displayOrder\":-1,\"externalOptions\":true,\"fieldType\":\"checkbox\",\"form