"hubspotDefined\":true,\"label\":\"Deal Pipeline\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_deal_pipeline_id\",\"options\":[],\"type\":\"enumeration\",\"updatedAt\":\"2026-02-18T19:04:09.642Z\"},{\"calculated\":true,\"calculationFormula\":\"(hs_deal_amount * hs_deal_split_percentage)\",\"createdAt\":\"2021-03-05T20:04:01.264Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The amount of the associated deal amount that should be credited to the owner of the deal split\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"deal_split_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Deal split amount\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_deal_split_amount\",\"options\":[],\"showCurrencySymbol\":true,\"type\":\"number\",\"updatedAt\":\"2025-10-07T13:03:08.837Z\"},{\"calculated\":true,\"calculationFormula\":\"(hs_deal_amount_in_home_currency * hs_deal_split_percentage)\",\"createdAt\":\"2021-04-12T20:14:14.494Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The amount of the associated deal amount that should be credited to the owner of the deal split in company currency\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"deal_split_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Deal split amount in company currency\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_deal_split_amount_in_home_currency\",\"options\":[],\"showCurrencySymbol\":true,\"type\":\"number\",\"updatedAt\":\"2025-10-07T13:03:08.837Z\"},{\"calculated\":true,\"calculationFormula\":\"if is_present(hs_deal_forecast_probability) then (hs_deal_split_amount_in_home_currency * hs_deal_forecast_probability) else hs_deal_split_amount_in_home_currency\",\"createdAt\":\"2021-03-05T20:15:50.211Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The custom forecasted deal split value calculated by multiplying the associated deal forecast probability and deal split amount\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"deal_split_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Deal split forecast amount\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_deal_split_forecast_amount\",\"options\":[],\"showCurrencySymbol\":true,\"type\":\"number\",\"updatedAt\":\"2025-10-07T13:03:08.837Z\"},{\"calculated\":false,\"createdAt\":\"2021-03-05T19:54:28.195Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The percentage of the associated deal amount that should be credited to the owner of the deal split\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"deal_split_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Deal Split Percentage\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_deal_split_percentage\",\"numberDisplayHint\":\"percentage\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2025-11-13T19:22:08.483Z\"},{\"calculated\":false,\"calculationFormula\":\"if is_present(hs_deal_stage_probability) then (hs_deal_split_amount * hs_deal_stage_probability) else 0\",\"createdAt\":\"2021-05-24T20:12:50.304Z\",\"currencyPropertyName\":\"hs_deal_currency_code\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Returns the multiplication of the deal split amount times the probability of the deal closing.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"deal_split_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Weighted deal split amount\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_deal_split_projected_amount\",\"options\":[],\"showCurrencySymbol\":true,\"type\":\"number\",\"updatedAt\":\"2025-10-07T13:03:08.837Z\"},{\"calculated\":false,\"calculationFormula\":\"if is_present(hs_deal_stage_probability) then (hs_deal_split_amount_in_home_currency * hs_deal_stage_probability) else 0\",\"createdAt\":\"2021-05-24T20:13:15.236Z\",\"currencyPropertyName\":\"hs_deal_currency_code\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Returns the multiplication of the deal split amount in home currency times the probability of the deal closing.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"deal_split_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Weighted deal split amount in company currency\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_deal_split_projected_amount_in_home_currency\",\"options\":[],\"showCurrencySymbol\":true,\"type\":\"number\",\"updatedAt\":\"2025-10-07T13:03:08.837Z\"},{\"calculated\":false,\"createdAt\":\"2022-05-04T19:22:43.695Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The type of deal split of an associated deal\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"select\",\"formField\":false,\"groupName\":\"deal_split_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Deal Split Type\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_deal_split_type\",\"options\":[],\"type\":\"enumeration\",\"updatedAt\":\"2025-10-07