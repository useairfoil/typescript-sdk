ormField\":false,\"groupName\":\"lead_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Message Thread Count\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_lead_communication_count\",\"numberDisplayHint\":\"unformatted\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2026-08-06T17:43:40.950Z\"},{\"calculated\":false,\"createdAt\":\"2023-04-05T20:14:07.373Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Currency code for most recent associated deal\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"select\",\"formField\":false,\"groupName\":\"lead_information\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Currency\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_lead_currency_code\",\"options\":[],\"type\":\"enumeration\",\"updatedAt\":\"2026-07-22T17:21:15.328Z\"},{\"calculated\":false,\"createdAt\":\"2023-03-23T14:20:19.686Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"A note on why the lead was disqualified \",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"textarea\",\"formField\":false,\"groupName\":\"lead_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Lead Disqualification Note\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_lead_disqualification_note\",\"options\":[],\"type\":\"string\",\"updatedAt\":\"2026-07-22T17:21:15.328Z\"},{\"calculated\":false,\"createdAt\":\"2023-04-25T16:44:25.370Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Dropdown list of reasons for disqualification\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"select\",\"formField\":false,\"groupName\":\"lead_information\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":