ue, false otherwise.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"deal_activity\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Has Last Conversation Follow Ups\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_has_last_conversation_follow_ups\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"Yes\",\"value\":\"true\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"No\",\"value\":\"false\"}],\"type\":\"bool\",\"updatedAt\":\"2026-03-03T22:24:30.740Z\"},{\"calculated\":true,\"calculationFormula\":\"is_present(hs_last_meeting_id_with_followups)\",\"createdAt\":\"2025-12-04T19:49:21.447Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Indicates if the most recent meeting has follow ups. True if hs_last_meeting_id_with_followups has a value, false otherwise.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"deal_activity\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Has Last Meeting Follow Ups\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_has_last_meeting_followups\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"True\",\"value\":\"true\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"False\",\"value\":\"false\"}],\"type\":\"bool\",\"updatedAt\":\"2026-01-12T19:13:43.020Z\"},{\"calculated\":false,\"createdAt\":\"2024-01-10T18:05:14.186Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Indicates if the current deal is an active shared deal. It is set automatically based on the value of hs_num_associated_active_deal_registrations.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"booleancheckbox\",\"formField\":false,\"groupName\":\"deal_activity\",\"hasUniqueValue