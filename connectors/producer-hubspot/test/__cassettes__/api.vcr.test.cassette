alse,\"hubspotDefined\":true,\"label\":\"Deal Score\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_deal_score\",\"options\":[],\"type\":\"number\",\"updatedAt\":\"2025-01-11T03:34:52.434Z\"},{\"calculated\":false,\"createdAt\":\"2021-07-29T14:25:44.469Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The probability a deal will close. This defaults to the deal stage probability setting.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"number\",\"formField\":false,\"groupName\":\"dealinformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Deal probability\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":false},\"name\":\"hs_deal_stage_probability\",\"numberDisplayHint\":\"percentage\",\"options\":[],\"showCurrencySymbol\":false,\"type\":\"number\",\"updatedAt\":\"2026-03-27T20:26:15.448Z\"},{\"calculated\":false,\"calculationFormula\":\"if is_present(pipeline_probability(string(dealstage))) then pipeline_probability(string(dealstage)) else 0\",\"createdAt\":\"2021-05-20T13:32:10.289Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Fall back property for calculating the deal stage when no customer override exist.  Probability between 0 and 1 of deal stage. Defaults to 0 for unknown deal stages.\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"dealinformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"Deal stage probability shadow\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_deal_stage_probability_shadow\",\"options\":[],\"showCurrencySymbol\":false,\"type\":\"number\",\"updatedAt\":\"2026-03-27T20:26:15.448Z\"},{\"calculated\":false,\"createdAt\":\"2023-11-13T02:58:40.834Z\",\"dataSensitivity\":\"non_sensitive\",