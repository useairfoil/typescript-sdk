ies for this record.\",\"displayOrder\":-1,\"externalOptions\":true,\"fieldType\":\"checkbox\",\"formField\":false,\"groupName\":\"lineiteminformation\",\"hasUniqueValue\":false,\"hidden\":true,\"hubspotDefined\":true,\"label\":\"All team IDs\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_all_team_ids\",\"options\":[],\"type\":\"enumeration\"},{\"calculated\":false,\"createdAt\":\"2022-04-06T20:52:26.036Z\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"Whether buyer selected quantity is to be enabled or not for a LineItem\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"booleancheckbox\",\"formField\":false,\"groupName\":\"lineiteminformation\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Allow buyer selected quantity\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_allow_buyer_selected_quantity\",\"options\":[{\"displayOrder\":0,\"hidden\":false,\"label\":\"Yes\",\"value\":\"true\"},{\"displayOrder\":1,\"hidden\":false,\"label\":\"No\",\"value\":\"false\"}],\"type\":\"enumeration\",\"updatedAt\":\"2024-05-20T18:27:15.506Z\"},{\"calculated\":true,\"calculationFormula\":\"round_nearest(if is_present(string(recurringbillingfrequency)) then if ((is_present(bool(hs_use_prorating)) and bool(hs_use_prorating)) and period_to_months(string(hs_recurring_billing_period)) < 12) then amount\\nelseif (string(recurringbillingfrequency) equals 'weekly' or string(recurringbillingfrequency) equals 'biweekly') then (hs_unscaled_amount * if is_present(string(hs_recurring_billing_period)) then min((period_to_weeks(string(hs_recurring_billing_period)) / if string(recurringbillingfrequency) equals 'weekly' then 1\\nelseif string(recurringbillingfrequency) equals 'biweekly' then 2 endif), if string(recurringbillingfrequency) equals 'weekly' then 52\\nelseif string(recurringbillingfrequency) equals 'biweekly' then 26 endif)\\nelseif string(recurringbillingfrequency) equals 'weekly' then 52\\nelseif string(recurringbillingfrequency) equals 'biweekly' then 26 endif) else ((hs_unscaled_amount / if string(recurringbillingfrequency) equals 'monthly' then 1\\nelseif string(recurringbillingfrequency) equals 'annually' then 12\\nelseif string(recurringbillingfrequency) equals 'per_five_years' then 60\\nelseif string(recurringbillingfrequency) equals 'per_four_years' then 48\\nelseif string(recurringbillingfrequency) equals 'per_three_years' then 36\\nelseif string(recurringbillingfrequency) equals 'per_two_years' then 24\\nelseif string(recurringbillingfrequency) equals 'per_six_months' then 6\\nelseif string(recurringbillingfrequency) equals 'quarterly' then 3 endif) * min(if is_present(hs_term_in_months) then hs_term_in_months else 12, 12)) else 0, if is_present(currency_decimal_places(string(hs_line_item_currency_code))) then currency_decimal_places(string(hs_line_item_currency_code))\\nelseif is_present(currency_decimal_places(fetch_single_currency_portal_currency)) then currency_decimal_places(fetch_single_currency_portal_currency) else 2)\",\"createdAt\":\"2020-03-25T19:42:21.220Z\",\"currencyPropertyName\":\"hs_line_item_currency_code\",\"dataSensitivity\":\"non_sensitive\",\"description\":\"The annual recurring revenue (ARR) of this product\",\"displayOrder\":-1,\"externalOptions\":false,\"fieldType\":\"calculation_equation\",\"formField\":false,\"groupName\":\"price\",\"hasUniqueValue\":false,\"hidden\":false,\"hubspotDefined\":true,\"label\":\"Annual recurring revenue\",\"modificationMetadata\":{\"archivable\":true,\"readOnlyDefinition\":true,\"readOnlyValue\":true},\"name\":\"hs_arr\",\"options\":[],\"showCurrencySymbol\":true,\"type\":\"number\",\"updatedAt\":\"2026-02-25T17:48:45.069Z\"},{\"calculated\":false,\"createdAt\":\"2024-08-08T22:33:04.198Z\",\"currencyPropertyName\":\"hs_line_item_currency_code\",\"dataSensitivity\":\"non_sensitive\",\"description\"