{
  "name": "@useairfoil/producer-polar",
  "version": "0.2.2",
  "repository": "useairfoil/typescript-sdk",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "docker:build": "docker build --load --file Dockerfile --tag airfoil/producer-polar:local ../..",
    "start": "tsx --env-file=.env src/main.ts start",
    "sandbox": "tsx --env-file=.env src/main.ts sandbox",
    "test": "dotenvx run --ignore=MISSING_ENV_FILE --quiet -- vitest",
    "test:ci": "dotenvx run --ignore=MISSING_ENV_FILE --quiet -- vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@useairfoil/connector-kit": "workspace:*",
    "@useairfoil/wings": "workspace:*",
    "effect": "catalog:",
    "standardwebhooks": "^1.0.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.62.0",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@useairfoil/effect-vcr": "workspace:*",
    "tsdown": "catalog:",
    "tsx": "^4.21.0",
    "vitest": "catalog:"
  }
}
