            "body": "{\"links\":{\"next\":\"https://stealth-37618.zendesk.com/api/v2/satisfaction_ratings.json?page%5Bafter%5D=eyJvIjoiLWNyZWF0ZWRfYXQsLWlkIiwidiI6IlpCdUh5R29BQUFBQWFSMEIxVmd0SkFBQSJ9&page%5Bsize%5D=100&start_time=1791494400\",\"prev\":\"https://stealth-37618.zendesk.com/api/v2/satisfaction_ratings.json?page%5Bbefore%5D=eyJvIjoiLWNyZWF0ZWRfYXQsLWlkIiwidiI6IlpDU0l5R29BQUFBQWFSMW8vMXN0SkFBQSJ9&page%5Bsize%5D=100&start_time=1791494400\"},\"meta\":{\"after_cursor\":\"eyJvIjoiLWNyZWF0ZWRfYXQsLWlkIiwidiI6IlpCdUh5R29BQUFBQWFSMEIxVmd0SkFBQSJ9\",\"before_cursor\":\"eyJvIjoiLWNyZWF0ZWRfYXQsLWlkIiwidiI6IlpDU0l5R29BQUFBQWFSMW8vMXN0SkFBQSJ9\",\"has_more\":false},\"satisfaction_ratings\":[{\"assignee_id\":39771704393373,\"comment\":null,\"created_at\":\"2026-10-09T06:22:28Z\",\"group_id\":39771663256989,\"id\":39777235593245,\"requester_id\":39771850790941,\"score\":\"bad\",\"ticket_id\":3,\"updated_at\":\"2026-10-09T06:22:28Z\",\"url\":\"https://stealth-37618.zendesk.com/api/v2/satisfaction_ratings/39777235593245.json\"},{\"assignee_id\":39771704393373,\"comment\":null,\"created_at\":\"2026-10-09T06:21:58Z\",\"group_id\":39771663256989,\"id\":39777233850141,\"requester_id\":39771850790941,\"score\":\"offered\",\"ticket_id\":3,\"updated_at\":\"2026-10-09T06:21:58Z\",\"url\":\"https://stealth-37618.zendesk.com/api/v2/satisfaction_ratings/39777233850141.json\"},{\"assignee_id\":39771704393373,\"comment\":\"Took too long to get a reply.\",\"created_at\":\"2026-10-09T06:19:23Z\",\"group_id\":39771663256989,\"id\":39777203359517,\"requester_id\":39776679352733,\"score\":\"good\",\"ticket_id\":6,\"updated_at\":\"2026-10-09T06:19:23Z\",\"url\":\"https://stealth-37618.zendesk.com/api/v2/satisfaction_ratings/39777203359517.json\"},{\"assignee_id\":39771704393373,\"comment\":null,\"created_at\":\"2026-10-09T06:19:08Z\",\"group_id\":39771663256989,\"id\":39777185910301,\"requester_id\":39771868857245,\"score\":\"offered\",\"ticket_id\":2,\"updated_at\":\"2026-10-09T06:19:08Z\",\"url\":\"https://stealth-37618.zendesk.com/api/v2/satisfaction_ratings/39777185910301.json\"},{\"assignee_id\":39771704393373,\"comment\":\"Took too long to get a reply.\",\"created_at\":\"2026-10-09T06:18:21Z\",\"group_id\":39771663256989,\"id\":39777171121437,\"requester_id\":39776679352733,\"score\":\"bad\",\"ticket_id\":6,\"updated_at\":\"2026-10-09T06:18:21Z\",\"url\":\"https://stealth-37618.zendesk.com/api/v2/satisfaction_ratings/39777171121437.json\"},{\"assignee_id\":39771704393373,\"comment\":null,\"created_at\":\"2026-10-09T06:18:03Z\",\"group_id\":39771663256989,\"id\":39777182482717,\"requester_id\":39776679352733,\"score\":\"offered\",\"ticket_id\":6,\"updated_at\":\"2026-10-09T06:18:03Z\",\"url\":\"https://stealth-37618.zendesk.com/api/v2/satisfaction_ratings/39777182482717.json\"}]}",
