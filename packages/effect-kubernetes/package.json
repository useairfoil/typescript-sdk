{
  "name": "@useairfoil/effect-kubernetes",
  "version": "0.1.0",
  "keywords": [
    "effect",
    "kubernetes"
  ],
  "repository": "useairfoil/typescript-sdk",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./operator": {
      "types": "./dist/operator/index.d.mts",
      "import": "./dist/operator/index.mjs",
      "default": "./dist/operator/index.mjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.mts",
      "import": "./dist/testing/index.mjs",
      "default": "./dist/testing/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "example:memcached": "tsx examples/memcached-operator.ts",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:integration:memcached": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@kubernetes/client-node": "^1.4.0",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "tsdown": "catalog:",
    "tsx": "^4.21.0",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "@kubernetes/client-node": {
      "optional": false
    },
    "effect": {
      "optional": false
    }
  }
}
