# Template connector configuration (JSONPlaceholder).
#
# JSONPlaceholder is a free public REST API that does NOT require auth.
# You can uncomment an API token to see exactly where credentials plug in when
# you rename the template for a real API.

TEMPLATE_API_BASE_URL=https://jsonplaceholder.typicode.com
# TEMPLATE_API_TOKEN=anonymous
# TEMPLATE_WEBHOOK_SECRET= # only needed when verifying inbound webhooks
TEMPLATE_WEBHOOK_PORT=8080

WINGS_HOST=localhost:7777
WINGS_NAMESPACE=namespaces/default
TEMPLATE_POSTS_TABLE=namespaces/default/tables/template-posts

# Production `start` also requires a mounted connector JSON file and PostgreSQL state.
# Sandboxes do not use these values.
# AIRFOIL_CONFIG_PATH=/var/run/airfoil/config/config.json
# AIRFOIL_CONNECTOR_INSTANCE_ID=team-acme-template-primary
# AIRFOIL_STATE_TABLE=airfoil_connector_state
# POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/airfoil

# Optional OpenTelemetry trace and metric export. Logs remain local.
# The endpoint is the OTLP base URL; Connector Kit appends /v1/traces and /v1/metrics.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=producer-template
# OTEL_SERVICE_VERSION=0.1.0
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,team=data
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>,X-Axiom-Dataset=<dataset>
